<!--
  Dual-ant sumo model for replaying Isaac-Lab-trained hierarchical agents.
  GENERATED by assets/make_ant_xml.py -- edit that script, not this file.

  Both ants are the downstream player's single ant (ant_single.xml): the canonical
  Gym/MuJoCo ant geometry (which Isaac's ant_instanceable.usd was converted from)
  with Isaac's joint limits (legs +-40 deg, feet 30..100 deg), painted like the Isaac
  dual-Ant env: "me" blue with deep navy front feet, "foe" red with deep crimson front
  feet, both with the eyes the Isaac play scripts attach (render-only geoms: zero
  mass, no collision). Joint names are the Isaac names prefixed with me_/foe_; the
  policy<->sim joint mapping is resolved BY NAME (shared/transfer_cfg.py
  ISAAC_JOINT_ORDER), so the tree order is irrelevant to correctness.

  Collision filtering (contype/conaffinity) gives: me-floor, foe-floor, me-foe;
  NO self-collisions within an ant (Isaac runs with enabled_self_collisions=False).
    floor : contype=3 conaffinity=3
    me    : contype=1 conaffinity=2
    foe   : contype=2 conaffinity=1

  Numbers that are calibration knobs (timestep, damping, armature, density,
  friction, gear) live in shared/transfer_cfg.py and are mirrored here.
-->
<mujoco model="dual_ant_sumo">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.00833333" integrator="RK4">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <!-- armature/damping are the MEASURED Isaac ant values (PhysX ignores joint
         damping; armature=0.01), not the Gym ant defaults (1/1). See transfer_cfg.py. -->
    <default class="ant">
      <joint armature="0.01" damping="0" limited="true" type="hinge"/>
      <geom condim="3" density="5.0" friction="1 0.5 0.5" margin="0.01"
            size="0.08" type="capsule"/>
      <default class="me">
        <geom contype="1" conaffinity="2" rgba="0.2 0.4 1.0 1"/>
        <default class="me_front">
          <geom rgba="0.02 0.05 0.35 1"/>
        </default>
      </default>
      <default class="foe">
        <geom contype="2" conaffinity="1" rgba="1.0 0.2 0.2 1"/>
        <default class="foe_front">
          <geom rgba="0.55 0.05 0.08 1"/>
        </default>
      </default>
      <!-- Eyes: render-only, like the Isaac play scripts' decorate_ants(). No collision bits
           and zero mass, so the dynamics are exactly those of the eyeless model. -->
      <default class="eye">
        <geom type="ellipsoid" contype="0" conaffinity="0" mass="0" rgba="0.95 0.95 0.95 1"/>
      </default>
      <default class="pupil">
        <geom type="ellipsoid" contype="0" conaffinity="0" mass="0" rgba="0.02 0.02 0.02 1"/>
      </default>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.7 0.9" rgb2="0.1 0.15 0.25"
             width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.27 0.30"
             rgb2="0.32 0.34 0.38" width="300" height="300" mark="edge" markrgb="0.5 0.5 0.5"/>
    <material name="grid" texture="grid" texrepeat="12 12" texuniform="true" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="light" pos="0 0 12" dir="0 0 -1" diffuse="0.8 0.8 0.8" castshadow="false"/>
    <geom name="floor" type="plane" pos="0 0 0" size="14 14 0.1" material="grid"
          contype="3" conaffinity="3" condim="3" friction="1 0.5 0.5"/>

    <!-- Boundary at +-4: a line painted on the floor like the Isaac clips (visual only, no
         collision; the web player hides it and draws its own at the current arena size) -->
    <geom name="wall_yp" type="box" pos="0 4 0.005"  size="4.08 0.08 0.005" contype="0" conaffinity="0" rgba="0.002 0.004 0.03 0.6"/>
    <geom name="wall_yn" type="box" pos="0 -4 0.005" size="4.08 0.08 0.005" contype="0" conaffinity="0" rgba="0.002 0.004 0.03 0.6"/>
    <geom name="wall_xp" type="box" pos="4 0 0.005"  size="0.08 4.08 0.005" contype="0" conaffinity="0" rgba="0.002 0.004 0.03 0.6"/>
    <geom name="wall_xn" type="box" pos="-4 0 0.005" size="0.08 4.08 0.005" contype="0" conaffinity="0" rgba="0.002 0.004 0.03 0.6"/>

    <!-- ===================== ME ant (blue, navy front feet) ===================== -->
    <body name="me_torso" pos="-1 0 0.5" quat="1 0 0 0" childclass="me">
      <freejoint name="me_root"/>
      <geom name="me_torso_geom" type="sphere" size="0.25"/>
      <!-- Eyes on the upper front (+y) of the torso: flattened white domes with black pupils. -->
      <geom name="me_eye_l" class="eye" pos="-0.105 0.228 0.13" size="0.085 0.03825 0.085"/>
      <geom name="me_eye_r" class="eye" pos="0.105 0.228 0.13" size="0.085 0.03825 0.085"/>
      <geom name="me_pupil_l" class="pupil" pos="-0.105 0.256688 0.13" size="0.045 0.02025 0.045"/>
      <geom name="me_pupil_r" class="pupil" pos="0.105 0.256688 0.13" size="0.045 0.02025 0.045"/>
      <body name="me_fl_leg">
        <geom fromto="0 0 0 0.2 0.2 0"/>
        <body name="me_fl_aux" pos="0.2 0.2 0">
          <joint name="me_front_left_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 0.2 0.2 0"/>
          <body name="me_front_left_foot_body" pos="0.2 0.2 0">
            <joint name="me_front_left_foot" axis="-1 1 0" range="30 100"/>
            <geom class="me_front" fromto="0 0 0 0.4 0.4 0"/>
          </body>
        </body>
      </body>
      <body name="me_fr_leg">
        <geom fromto="0 0 0 -0.2 0.2 0"/>
        <body name="me_fr_aux" pos="-0.2 0.2 0">
          <joint name="me_front_right_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 -0.2 0.2 0"/>
          <body name="me_front_right_foot_body" pos="-0.2 0.2 0">
            <joint name="me_front_right_foot" axis="1 1 0" range="-100 -30"/>
            <geom class="me_front" fromto="0 0 0 -0.4 0.4 0"/>
          </body>
        </body>
      </body>
      <body name="me_lb_leg">
        <geom fromto="0 0 0 -0.2 -0.2 0"/>
        <body name="me_lb_aux" pos="-0.2 -0.2 0">
          <joint name="me_left_back_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 -0.2 -0.2 0"/>
          <body name="me_left_back_foot_body" pos="-0.2 -0.2 0">
            <joint name="me_left_back_foot" axis="-1 1 0" range="-100 -30"/>
            <geom fromto="0 0 0 -0.4 -0.4 0"/>
          </body>
        </body>
      </body>
      <body name="me_rb_leg">
        <geom fromto="0 0 0 0.2 -0.2 0"/>
        <body name="me_rb_aux" pos="0.2 -0.2 0">
          <joint name="me_right_back_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 0.2 -0.2 0"/>
          <body name="me_right_back_foot_body" pos="0.2 -0.2 0">
            <joint name="me_right_back_foot" axis="1 1 0" range="30 100"/>
            <geom fromto="0 0 0 0.4 -0.4 0"/>
          </body>
        </body>
      </body>
    </body>

    <!-- ===================== FOE ant (red, crimson front feet) ===================== -->
    <body name="foe_torso" pos="1 0 0.5" quat="0 0 0 1" childclass="foe">
      <freejoint name="foe_root"/>
      <geom name="foe_torso_geom" type="sphere" size="0.25"/>
      <!-- Eyes on the upper front (+y) of the torso: flattened white domes with black pupils. -->
      <geom name="foe_eye_l" class="eye" pos="-0.105 0.228 0.13" size="0.085 0.03825 0.085"/>
      <geom name="foe_eye_r" class="eye" pos="0.105 0.228 0.13" size="0.085 0.03825 0.085"/>
      <geom name="foe_pupil_l" class="pupil" pos="-0.105 0.256688 0.13" size="0.045 0.02025 0.045"/>
      <geom name="foe_pupil_r" class="pupil" pos="0.105 0.256688 0.13" size="0.045 0.02025 0.045"/>
      <body name="foe_fl_leg">
        <geom fromto="0 0 0 0.2 0.2 0"/>
        <body name="foe_fl_aux" pos="0.2 0.2 0">
          <joint name="foe_front_left_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 0.2 0.2 0"/>
          <body name="foe_front_left_foot_body" pos="0.2 0.2 0">
            <joint name="foe_front_left_foot" axis="-1 1 0" range="30 100"/>
            <geom class="foe_front" fromto="0 0 0 0.4 0.4 0"/>
          </body>
        </body>
      </body>
      <body name="foe_fr_leg">
        <geom fromto="0 0 0 -0.2 0.2 0"/>
        <body name="foe_fr_aux" pos="-0.2 0.2 0">
          <joint name="foe_front_right_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 -0.2 0.2 0"/>
          <body name="foe_front_right_foot_body" pos="-0.2 0.2 0">
            <joint name="foe_front_right_foot" axis="1 1 0" range="-100 -30"/>
            <geom class="foe_front" fromto="0 0 0 -0.4 0.4 0"/>
          </body>
        </body>
      </body>
      <body name="foe_lb_leg">
        <geom fromto="0 0 0 -0.2 -0.2 0"/>
        <body name="foe_lb_aux" pos="-0.2 -0.2 0">
          <joint name="foe_left_back_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 -0.2 -0.2 0"/>
          <body name="foe_left_back_foot_body" pos="-0.2 -0.2 0">
            <joint name="foe_left_back_foot" axis="-1 1 0" range="-100 -30"/>
            <geom fromto="0 0 0 -0.4 -0.4 0"/>
          </body>
        </body>
      </body>
      <body name="foe_rb_leg">
        <geom fromto="0 0 0 0.2 -0.2 0"/>
        <body name="foe_rb_aux" pos="0.2 -0.2 0">
          <joint name="foe_right_back_leg" axis="0 0 1" range="-40 40"/>
          <geom fromto="0 0 0 0.2 -0.2 0"/>
          <body name="foe_right_back_foot_body" pos="0.2 -0.2 0">
            <joint name="foe_right_back_foot" axis="1 1 0" range="30 100"/>
            <geom fromto="0 0 0 0.4 -0.4 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- gear=1: action->torque scaling is applied in code (transfer_cfg.ACTION_TORQUE_SCALE),
       so the policy's clipped action IS the joint torque. -->
  <actuator>
    <motor name="me_front_left_leg" joint="me_front_left_leg" gear="1" ctrllimited="false"/>
    <motor name="me_front_right_leg" joint="me_front_right_leg" gear="1" ctrllimited="false"/>
    <motor name="me_left_back_leg" joint="me_left_back_leg" gear="1" ctrllimited="false"/>
    <motor name="me_right_back_leg" joint="me_right_back_leg" gear="1" ctrllimited="false"/>
    <motor name="me_front_left_foot" joint="me_front_left_foot" gear="1" ctrllimited="false"/>
    <motor name="me_front_right_foot" joint="me_front_right_foot" gear="1" ctrllimited="false"/>
    <motor name="me_left_back_foot" joint="me_left_back_foot" gear="1" ctrllimited="false"/>
    <motor name="me_right_back_foot" joint="me_right_back_foot" gear="1" ctrllimited="false"/>

    <motor name="foe_front_left_leg" joint="foe_front_left_leg" gear="1" ctrllimited="false"/>
    <motor name="foe_front_right_leg" joint="foe_front_right_leg" gear="1" ctrllimited="false"/>
    <motor name="foe_left_back_leg" joint="foe_left_back_leg" gear="1" ctrllimited="false"/>
    <motor name="foe_right_back_leg" joint="foe_right_back_leg" gear="1" ctrllimited="false"/>
    <motor name="foe_front_left_foot" joint="foe_front_left_foot" gear="1" ctrllimited="false"/>
    <motor name="foe_front_right_foot" joint="foe_front_right_foot" gear="1" ctrllimited="false"/>
    <motor name="foe_left_back_foot" joint="foe_left_back_foot" gear="1" ctrllimited="false"/>
    <motor name="foe_right_back_foot" joint="foe_right_back_foot" gear="1" ctrllimited="false"/>
  </actuator>
</mujoco>
